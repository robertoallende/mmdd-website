---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <section class="mx-auto max-w-[1280px] px-4 py-24 text-center md:px-8">
    <h1 class="text-6xl font-bold text-[var(--color-text-strong)]">404</h1>
    <p class="mt-4 text-lg text-[var(--color-text-muted)]">Page not found.</p>
    <a href="/" class="mt-8 inline-block rounded-[var(--radius-ui)] bg-[var(--color-brand)] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-brand-hover)]">
      Back to Home
    </a>
  </section>
</Layout>
