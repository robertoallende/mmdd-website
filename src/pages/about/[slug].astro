---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getCategoriesForParent } from '@/data/docs';

export async function getStaticPaths() {
  const categories = getCategoriesForParent('about');
  const docs = await getCollection('docs');
  return docs
    .filter(d => categories.some(c => c.slug === d.data.category) && d.data.status === 'published')
    .map(doc => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<Layout title={doc.data.title} description={doc.data.description}>
  <article class="docs-article prose mx-auto max-w-3xl px-4 py-12 md:px-8">
    <h1>{doc.data.title}</h1>
    <Content />
  </article>
</Layout>
