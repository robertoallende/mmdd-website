---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getCategoriesForParent } from '@/data/docs';

const categories = getCategoriesForParent('about');
const allDocs = await getCollection('docs');
const docs = allDocs.filter(d => categories.some(c => c.slug === d.data.category) && d.data.status === 'published');
---

<Layout title="About" description="About MMDD and the community.">
  <section class="mx-auto max-w-[1280px] px-4 py-12 md:px-8">
    <h1 class="text-3xl font-bold text-[var(--color-text-strong)]">About</h1>
    <p class="mt-2 text-[var(--color-text-muted)]">About the project, community, and how to get involved.</p>
    <div class="mt-8 grid gap-4">
      {docs.map(doc => (
        <a href={`/about/${doc.id}`} class="block rounded-[var(--radius-ui)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-colors hover:border-[var(--color-accent)]">
          <h2 class="font-semibold text-[var(--color-text-strong)]">{doc.data.title}</h2>
          {doc.data.description && <p class="mt-1 text-sm text-[var(--color-text-muted)]">{doc.data.description}</p>}
        </a>
      ))}
    </div>
  </section>
</Layout>
