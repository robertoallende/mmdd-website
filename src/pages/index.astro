---
import Layout from '../layouts/Layout.astro';
import { docsParentCategories, getCategoriesForParent } from '../data/docs';
import site from '../../site.config.mjs';
---

<Layout title={site.title}>
  <section class="mx-auto max-w-[1280px] px-4 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-[var(--color-text-strong)] md:text-5xl">
        {site.title}
      </h1>
      <p class="mt-6 text-lg text-[var(--color-text-muted)]">
        {site.description}
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {docsParentCategories.map((parent) => (
        <a href={`/${parent.slug}`} class="group rounded-[var(--radius-ui)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-colors hover:border-[var(--color-accent)]">
          <h2 class="text-lg font-semibold text-[var(--color-text-strong)] group-hover:text-[var(--color-accent)]">
            {parent.name}
          </h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">
            {parent.description}
          </p>
        </a>
      ))}
    </div>
  </section>
</Layout>
